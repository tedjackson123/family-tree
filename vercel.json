{
  "version": 2,
  "builds": [
    { "src": "public/index.html", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/tree", "dest": "/api/tree.js" },
    { "src": "/api/story", "dest": "/api/story.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
